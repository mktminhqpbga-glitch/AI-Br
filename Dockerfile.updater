FROM node:22-bookworm-slim
WORKDIR /app
COPY --chown=node:node updater-server.mjs updater-control.mjs ./
COPY --chown=node:node updater-ui ./updater-ui
COPY --chown=node:node cloud-ui/dashboard.css ./cloud-ui/dashboard.css
ENV NODE_ENV=production BRIDGE_UPDATER_DATA_DIR=/var/data/ai-bridge-updater
EXPOSE 10000
CMD ["node", "updater-server.mjs"]
