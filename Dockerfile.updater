FROM scratch AS npm_cache
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=bind,from=npm_cache,target=/tmp/npm-cache \
    if [ -d /tmp/npm-cache/_cacache ]; then mkdir -p /root/.npm && cp -R /tmp/npm-cache/_cacache /root/.npm/ && export npm_config_offline=true; fi \
    && npm ci --omit=dev --no-audit --no-fund --fetch-retries=1 --fetch-timeout=20000 \
    && rm -rf /root/.npm
COPY --chown=node:node updater-server.mjs updater-control.mjs shared-state.mjs ./
COPY --chown=node:node updater-ui ./updater-ui
COPY --chown=node:node cloud-ui/dashboard.css ./cloud-ui/dashboard.css
ENV NODE_ENV=production BRIDGE_UPDATER_DATA_DIR=/var/data/ai-bridge-updater
EXPOSE 10000
CMD ["node", "updater-server.mjs"]
